{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monarch-mcp",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  // Create with: uv run pywrangler kv namespace create MONARCH_SESSIONS
  // then paste the returned id here.
  "kv_namespaces": [{ "binding": "MONARCH_SESSIONS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  // Logs contain tool arguments such as dates, IDs and amounts. Enable only while debugging.
  "observability": { "enabled": false }
}
