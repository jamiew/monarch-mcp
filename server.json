{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jamiew/monarch-mcp",
  "title": "Monarch MCP Server",
  "description": "Query and update Monarch Money accounts, transactions, and budgets",
  "version": "0.7.0",
  "repository": {
    "url": "https://github.com/jamiew/monarch-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "monarch-mcp-jamiew",
      "version": "0.7.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MONARCH_EMAIL",
          "description": "Monarch Money account email",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "MONARCH_PASSWORD",
          "description": "Monarch Money account password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "MONARCH_MFA_SECRET",
          "description": "TOTP secret for 2FA, not a rotating code",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MONARCH_FORCE_LOGIN",
          "description": "Set to 'true' to skip the cached session",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MONARCH_SESSION_DIR",
          "description": "Directory for the cached session (default ~/.monarch-mcp)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
